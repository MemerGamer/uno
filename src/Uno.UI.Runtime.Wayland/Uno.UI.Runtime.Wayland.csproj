<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>$(NetSkiaPreviousAndCurrent)</TargetFrameworks>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<Import Project="../Uno.UI.Runtime.Linux.Shared/Uno.UI.Runtime.Linux.Shared.props" />

	<Import Project="../targetframework-override-noplatform.props" />

	<PropertyGroup>
		<GeneratePackageOnBuild Condition="'$(Configuration)'=='Release'">true</GeneratePackageOnBuild>
		<Description>This package provides the Wayland host for Uno Platform projects.</Description>

		<PackageId>Uno.WinUI.Runtime.Wayland</PackageId>

		<RootNamespace>Uno.UI.Runtime.Wayland</RootNamespace>

		<UseCommonOverridePackage>true</UseCommonOverridePackage>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\Common\uno.png" Pack="true" PackagePath="\" />
		<None Update="Protocols/LICENSE.txt" Pack="true" PackagePath="licenses/wayland-protocols.txt" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Uno.UI.Runtime\Uno.UI.Runtime.csproj" />
		<ProjectReference Include="..\Uno.Foundation\Uno.Foundation.Generic.csproj" TreatAsPackageReference="false" PrivateAssets="all" />
		<ProjectReference Include="..\Uno.UI\Uno.UI.csproj" />
		<ProjectReference Include="..\Uno.WinRT\Uno.WinRT.Generic.csproj" TreatAsPackageReference="false" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="buildTransitive/*.*">
			<Pack>true</Pack>
			<PackagePath>buildTransitive</PackagePath>
		</Content>
	</ItemGroup>

	<!-- Protocol bindings are generated at build time from the vendored protocol XMLs, see Uno.UI.Runtime.Wayland.Scanner. -->
	<ItemGroup>
		<ProjectReference Include="..\Uno.UI.Runtime.Wayland.Scanner\Uno.UI.Runtime.Wayland.Scanner.csproj" ReferenceOutputAssembly="false" OutputItemType="WaylandScanner" PrivateAssets="all" TreatAsPackageReference="false" />
		<WaylandProtocol Include="Protocols/*.xml" />
		<Compile Remove="Protocols/*.g.cs" />
	</ItemGroup>

	<Target Name="GenerateWaylandProtocols" DependsOnTargets="ResolveProjectReferences" Inputs="@(WaylandScanner);@(WaylandProtocol)" Outputs="$(IntermediateOutputPath)WaylandProtocols/.generated">
		<PropertyGroup>
			<WaylandScannerDotNetHost Condition="'$(DotNetHostPath)' != ''">$(DotNetHostPath)</WaylandScannerDotNetHost>
			<WaylandScannerDotNetHost Condition="'$(WaylandScannerDotNetHost)' == ''">dotnet</WaylandScannerDotNetHost>
		</PropertyGroup>
		<RemoveDir Directories="$(IntermediateOutputPath)WaylandProtocols/" />
		<Exec Command="&quot;$(WaylandScannerDotNetHost)&quot; &quot;@(WaylandScanner)&quot; &quot;$(MSBuildProjectDirectory)/Protocols&quot; &quot;$(IntermediateOutputPath)WaylandProtocols/&quot;" />
		<Touch Files="$(IntermediateOutputPath)WaylandProtocols/.generated" AlwaysCreate="true" />
	</Target>

	<Target Name="CompileWaylandProtocols" BeforeTargets="CoreCompile" DependsOnTargets="GenerateWaylandProtocols">
		<ItemGroup>
			<Compile Include="$(IntermediateOutputPath)WaylandProtocols/*.g.cs" />
			<FileWrites Include="$(IntermediateOutputPath)WaylandProtocols/*" />
		</ItemGroup>
	</Target>

</Project>
