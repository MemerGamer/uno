<Project Sdk="MSTest.Sdk/4.0.2">

	<PropertyGroup>
		<TargetFramework>$(NetUnitTests)</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<DisablePrivateProjectReference>true</DisablePrivateProjectReference>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Uno.UI.Runtime.Wayland\Uno.UI.Runtime.Wayland.csproj" />
		<ProjectReference Include="..\Uno.UI.Runtime.Wayland.Scanner\Uno.UI.Runtime.Wayland.Scanner.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\Uno.UI.Runtime.Wayland\Protocols\*.xml" Link="protocols\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
