<Project>
	<!-- Display-server independent Linux desktop services (XDG desktop portals over D-Bus), compiled into the X11 and Wayland hosts. -->
	<ItemGroup>
		<PackageReference Include="Tmds.DBus.Protocol" Version="0.92.0" />
		<PackageReference Include="Tmds.DBus.Generator" Version="0.92.0" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="$(MSBuildThisFileDirectory)**/*.cs" Link="Linux/%(RecursiveDir)%(Filename)%(Extension)" />
		<AdditionalFiles Include="$(MSBuildThisFileDirectory)dbus-interfaces/org.freedesktop.portal.FileChooser.xml" Namespace="Uno.WinUI.Runtime.Skia.Linux.DBus" GenerateDBusTypes="true" />
		<AdditionalFiles Include="$(MSBuildThisFileDirectory)dbus-interfaces/org.freedesktop.portal.Request.xml" Namespace="Uno.WinUI.Runtime.Skia.Linux.DBus" GenerateDBusTypes="true" />
		<AdditionalFiles Include="$(MSBuildThisFileDirectory)dbus-interfaces/org.freedesktop.portal.Settings.xml" Namespace="Uno.WinUI.Runtime.Skia.Linux.DBus" GenerateDBusTypes="true" />
	</ItemGroup>
</Project>
