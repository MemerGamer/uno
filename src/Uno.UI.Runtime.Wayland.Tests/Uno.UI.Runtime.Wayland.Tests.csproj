<Project Sdk="MSTest.Sdk/4.0.2">

	<!--
		Host-independent tests of the Wayland runtime: the protocol scanner, the generated bindings and the
		display dispatch (against an in-process protocol peer), pipe transfers, and the pure window, frame, input,
		selection and drop logic. The sources are linked rather than referenced, so the tests need neither Uno.UI nor
		a compositor; display tests need libwayland-client and compose tests libxkbcommon.
	-->
	<PropertyGroup>
		<TargetFramework>$(NetUnitTests)</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Uno.UI.Runtime.Wayland.Scanner\Uno.UI.Runtime.Wayland.Scanner.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\Uno.UI.Runtime.Wayland\Native\**\*.cs" Link="Native\%(RecursiveDir)%(Filename)%(Extension)" />
		<Compile Include="..\Uno.UI.Runtime.Wayland\Protocols\**\*.cs" Link="Protocols\%(RecursiveDir)%(Filename)%(Extension)" />
		<Compile Include="..\Uno.UI.Runtime.Wayland\Rendering\WaylandRenderScale.cs;..\Uno.UI.Runtime.Wayland\Rendering\WaylandRenderThread.cs;..\Uno.UI.Runtime.Wayland\Rendering\WaylandEglConfig.cs;..\Uno.UI.Runtime.Wayland\Rendering\WaylandFrameScheduler.cs" Link="Rendering\%(Filename)%(Extension)" />
		<Compile Include="..\Uno.UI.Runtime.Wayland\Hosting\WaylandOutput.cs;..\Uno.UI.Runtime.Wayland\Hosting\WaylandFrameReadiness.cs;..\Uno.UI.Runtime.Wayland\Hosting\WaylandDecorationLayout.cs;..\Uno.UI.Runtime.Wayland\Hosting\WaylandToplevelStates.cs;..\Uno.UI.Runtime.Wayland\Hosting\WaylandNonClientRegions.cs" Link="Hosting\%(Filename)%(Extension)" />
		<Compile Include="..\Uno.UI.Runtime.Wayland\Input\WaylandPointerPress.cs;..\Uno.UI.Runtime.Wayland\Input\WaylandXkb.cs;..\Uno.UI.Runtime.Wayland\Input\WaylandKeyboardCompose.cs" Link="Input\%(Filename)%(Extension)" />
		<Compile Include="..\Uno.UI.Runtime.Wayland\ApplicationModel\DataTransfer\WaylandFileUris.cs" Link="DataTransfer\WaylandFileUris.cs" />
		<Compile Include="..\Uno.UI.Runtime.Wayland\ApplicationModel\DataTransfer\WaylandDropNegotiation.cs" Link="DataTransfer\WaylandDropNegotiation.cs" />
		<Compile Include="..\Uno.UI.Runtime.Wayland\ApplicationModel\DataTransfer\WaylandSelectionSerial.cs" Link="DataTransfer\WaylandSelectionSerial.cs" />
		<None Include="..\Uno.UI.Runtime.Wayland\Protocols\*.xml" Link="protocols\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
